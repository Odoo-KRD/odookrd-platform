generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("company_status")
}

enum AccountScope {
  PLATFORM
  COMPANY

  @@map("account_scope")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum RoleScope {
  PLATFORM
  COMPANY

  @@map("role_scope")
}

enum AuthTokenType {
  INVITATION
  PASSWORD_RESET

  @@map("auth_token_type")
}

enum ServiceCategory {
  ODOO
  HOSTING
  DOMAIN
  SUPPORT
  TRAINING
  OTHER

  @@map("service_category")
}

enum ServiceCatalogStatus {
  ACTIVE
  INACTIVE

  @@map("service_catalog_status")
}

enum CompanyServiceStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED

  @@map("company_service_status")
}

enum SettingScope {
  PLATFORM
  COMPANY

  @@map("setting_scope")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP

  @@map("notification_channel")
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED

  @@map("notification_delivery_status")
}

model Company {
  id               String        @id @default(uuid()) @db.Uuid
  name             String        @db.VarChar(200)
  nameTranslations Json          @default("{}") @map("name_translations") @db.JsonB
  status           CompanyStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                  User[]
  settings               Setting[]
  serviceAssignments     CompanyService[]
  notifications          Notification[]
  notificationRecipients NotificationRecipient[]

  @@map("companies")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  companyId       String?      @map("company_id") @db.Uuid
  accountScope    AccountScope @map("account_scope")
  email           String       @db.VarChar(320)
  normalizedEmail String       @unique @map("normalized_email") @db.VarChar(320)
  passwordHash    String?      @map("password_hash") @db.VarChar(255)
  status          UserStatus   @default(INVITED)
  emailVerifiedAt DateTime?    @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  company                Company?                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userRoles              UserRole[]
  sessions               Session[]
  authTokens             AuthToken[]
  notificationRecipients NotificationRecipient[]

  @@index([companyId])
  @@index([status])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique @db.VarChar(100)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  scope       RoleScope
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([scope])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(150)
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(128)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  action      String   @db.VarChar(150)
  targetType  String?  @map("target_type") @db.VarChar(100)
  targetId    String?  @map("target_id") @db.VarChar(255)
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorUserId])
  @@index([companyId])
  @@index([action])
  @@index([createdAt])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

model Setting {
  id             String       @id @default(uuid()) @db.Uuid
  key            String       @db.VarChar(150)
  category       String       @db.VarChar(80)
  valueType      String       @map("value_type") @db.VarChar(32)
  scope          SettingScope
  scopeKey       String       @map("scope_key") @db.VarChar(80)
  companyId      String?      @map("company_id") @db.Uuid
  value          Json?        @db.JsonB
  encryptedValue String?      @map("encrypted_value") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([scopeKey, key], map: "settings_scope_key_key_unique")
  @@index([scope, companyId], map: "settings_scope_company_id_idx")
  @@index([category], map: "settings_category_idx")
  @@map("settings")
}

model Service {
  id                      String               @id @default(uuid()) @db.Uuid
  key                     String               @unique @db.VarChar(100)
  name                    String               @db.VarChar(200)
  nameTranslations        Json                 @default("{}") @map("name_translations") @db.JsonB
  category                ServiceCategory
  description             String?              @db.VarChar(1000)
  descriptionTranslations Json                 @default("{}") @map("description_translations") @db.JsonB
  status                  ServiceCatalogStatus @default(ACTIVE)
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments CompanyService[]

  @@index([category, status], map: "services_category_status_idx")
  @@map("services")
}

model CompanyService {
  id                      String               @id @default(uuid()) @db.Uuid
  companyId               String               @map("company_id") @db.Uuid
  serviceId               String               @map("service_id") @db.Uuid
  displayName             String?              @map("display_name") @db.VarChar(200)
  displayNameTranslations Json                 @default("{}") @map("display_name_translations") @db.JsonB
  status                  CompanyServiceStatus @default(PROVISIONING)
  serviceUrl              String?              @map("service_url") @db.VarChar(2048)
  startsAt                DateTime?            @map("starts_at") @db.Timestamptz(6)
  expiresAt               DateTime?            @map("expires_at") @db.Timestamptz(6)
  notes                   String?              @db.VarChar(2000)
  internalNotes           String?              @map("internal_notes") @db.VarChar(2000)
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([companyId, status], map: "company_services_company_status_idx")
  @@index([serviceId], map: "company_services_service_id_idx")
  @@index([expiresAt], map: "company_services_expires_at_idx")
  @@map("company_services")
}

model Notification {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  templateKey    String   @map("template_key") @db.VarChar(150)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(200)
  actionUrl      String?  @map("action_url") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  recipients NotificationRecipient[]

  @@unique([companyId, idempotencyKey], map: "notifications_company_idempotency_unique")
  @@index([companyId, createdAt], map: "notifications_company_created_at_idx")
  @@map("notifications")
}

model NotificationRecipient {
  id             String    @id @default(uuid()) @db.Uuid
  notificationId String    @map("notification_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  locale         String    @db.VarChar(10)
  title          String    @db.VarChar(300)
  body           String    @db.VarChar(4000)
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  notification Notification           @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  company      Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveries   NotificationDelivery[]

  @@unique([notificationId, userId], map: "notification_recipients_notification_user_unique")
  @@index([companyId, userId, readAt, createdAt], map: "notification_recipients_inbox_idx")
  @@map("notification_recipients")
}

model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  recipientId       String                     @map("recipient_id") @db.Uuid
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  destination       String?                    @db.VarChar(320)
  attemptCount      Int                        @default(0) @map("attempt_count")
  maxAttempts       Int                        @default(3) @map("max_attempts")
  providerMessageId String?                    @map("provider_message_id") @db.VarChar(255)
  failureCode       String?                    @map("failure_code") @db.VarChar(80)
  failureMessage    String?                    @map("failure_message") @db.VarChar(255)
  lastAttemptAt     DateTime?                  @map("last_attempt_at") @db.Timestamptz(6)
  nextAttemptAt     DateTime?                  @map("next_attempt_at") @db.Timestamptz(6)
  sentAt            DateTime?                  @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipient NotificationRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, channel], map: "notification_deliveries_recipient_channel_unique")
  @@index([status, nextAttemptAt], map: "notification_deliveries_retry_idx")
  @@map("notification_deliveries")
}
