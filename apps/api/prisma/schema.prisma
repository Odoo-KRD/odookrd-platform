  attemptId         String   @map("attempt_id") @db.Uuid
  questionId        String   @map("question_id") @db.Uuid
  selectedOptionIds Json     @default("[]") @map("selected_option_ids") @db.JsonB
  isCorrect         Boolean? @map("is_correct")
  pointsAwarded     Int?     @map("points_awarded")
  answeredAt        DateTime @default(now()) @map("answered_at") @db.Timestamptz(6)

  attempt  TrainingQuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question TrainingQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId], map: "training_quiz_answers_attempt_question_unique")
  @@index([questionId], map: "training_quiz_answers_question_idx")
  @@map("training_quiz_attempt_answers")
}

model TrainingCourseCompletion {
  id                      String   @id @default(uuid()) @db.Uuid
  companyId               String   @map("company_id") @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  courseId                String   @map("course_id") @db.Uuid
  courseTitleSnapshot     String   @map("course_title_snapshot") @db.VarChar(250)
  courseTitleTranslations Json     @default("{}") @map("course_title_translations") @db.JsonB
  finalScorePercentage    Int?     @map("final_score_percentage")
  requirementSnapshot     Json     @default("{}") @map("requirement_snapshot") @db.JsonB
  completedAt             DateTime @map("completed_at") @db.Timestamptz(6)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  course      TrainingCourse       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  certificate TrainingCertificate?

  @@unique([userId, courseId], map: "training_course_completions_user_course_unique")
  @@index([companyId, completedAt(sort: Desc)], map: "training_course_completions_company_idx")
  @@index([courseId, completedAt(sort: Desc)], map: "training_course_completions_course_idx")
  @@map("training_course_completions")
}

model TrainingCertificate {
  id                      String                    @id @default(uuid()) @db.Uuid
  completionId            String                    @unique @map("completion_id") @db.Uuid
  templateId              String                    @map("template_id") @db.Uuid
  companyId               String                    @map("company_id") @db.Uuid
  userId                  String                    @map("user_id") @db.Uuid
  courseId                String                    @map("course_id") @db.Uuid
  certificateNumber       String                    @unique @map("certificate_number") @db.VarChar(100)
  verificationCodeHash    String                    @unique @map("verification_code_hash") @db.VarChar(128)
  learnerNameSnapshot     String                    @map("learner_name_snapshot") @db.VarChar(250)
  learnerEmailSnapshot    String                    @map("learner_email_snapshot") @db.VarChar(320)
  companyNameSnapshot     String                    @map("company_name_snapshot") @db.VarChar(200)
  courseTitleSnapshot     String                    @map("course_title_snapshot") @db.VarChar(250)
  courseTitleTranslations Json                      @default("{}") @map("course_title_translations") @db.JsonB
  locale                  String                    @db.VarChar(10)
  scorePercentage         Int?                      @map("score_percentage")
  status                  TrainingCertificateStatus @default(ACTIVE)
  issuedAt                DateTime                  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt               DateTime?                 @map("expires_at") @db.Timestamptz(6)
  pdfStorageProvider      TrainingStorageProvider?  @map("pdf_storage_provider")
  pdfStorageReference     String?                   @map("pdf_storage_reference") @db.VarChar(2048)
  pdfChecksum             String?                   @map("pdf_checksum") @db.VarChar(128)
  revokedAt               DateTime?                 @map("revoked_at") @db.Timestamptz(6)
  revocationReason        String?                   @map("revocation_reason") @db.VarChar(1000)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  completion TrainingCourseCompletion    @relation(fields: [completionId], references: [id], onDelete: Restrict)
  template   TrainingCertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  company    Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user       User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  course     TrainingCourse              @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([companyId, issuedAt(sort: Desc)], map: "training_certificates_company_issued_idx")
  @@index([userId, issuedAt(sort: Desc)], map: "training_certificates_user_issued_idx")
  @@index([courseId, issuedAt(sort: Desc)], map: "training_certificates_course_issued_idx")
  @@map("training_certificates")
}
