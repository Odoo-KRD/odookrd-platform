generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("company_status")
}

enum AccountScope {
  PLATFORM
  COMPANY

  @@map("account_scope")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("user_status")
}

enum RoleScope {
  PLATFORM
  COMPANY

  @@map("role_scope")
}

enum AuthTokenType {
  INVITATION
  PASSWORD_RESET

  @@map("auth_token_type")
}

enum ServiceCategory {
  ODOO
  HOSTING
  DOMAIN
  SUPPORT
  TRAINING
  OTHER

  @@map("service_category")
}

enum ServiceCatalogStatus {
  ACTIVE
  INACTIVE

  @@map("service_catalog_status")
}

enum CompanyServiceStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED

  @@map("company_service_status")
}

enum ServiceFeatureValueType {
  BOOLEAN
  NUMBER
  STORAGE
  TEXT

  @@map("service_feature_value_type")
}

enum ServiceFeatureStatus {
  ACTIVE
  INACTIVE

  @@map("service_feature_status")
}

enum CompanyServiceFeatureSource {
  CATALOG_DEFAULT
  ADMIN_OVERRIDE

  @@map("company_service_feature_source")
}

enum CompanyServiceLifecycleSource {
  ADMIN
  SYSTEM
  INTEGRATION

  @@map("company_service_lifecycle_source")
}

enum SettingScope {
  PLATFORM
  COMPANY

  @@map("setting_scope")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP

  @@map("notification_channel")
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED

  @@map("notification_delivery_status")
}

enum FileAssetKind {
  IMAGE
  DOCUMENT
  ATTACHMENT

  @@map("file_asset_kind")
}

enum FileStorageProvider {
  LOCAL
  AWS_S3

  @@map("file_storage_provider")
}

enum FileAssetStatus {
  READY
  DELETED

  @@map("file_asset_status")
}

enum TrainingCategoryStatus {
  ACTIVE
  INACTIVE

  @@map("training_category_status")
}

enum TrainingCourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("training_course_status")
}

enum TrainingContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("training_content_status")
}

enum TrainingStorageProvider {
  AWS_S3
  LOCAL

  @@map("training_storage_provider")
}

enum TrainingVideoAssetStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  ARCHIVED

  @@map("training_video_asset_status")
}

enum TrainingAudienceMode {
  ALL_USERS
  ASSIGNED_USERS

  @@map("training_audience_mode")
}

enum TrainingUserAccessSource {
  PLATFORM
  COMPANY_ADMIN

  @@map("training_user_access_source")
}

enum TrainingProgressStatus {
  IN_PROGRESS
  COMPLETED

  @@map("training_progress_status")
}

enum TrainingQuizPlacement {
  SECTION
  COURSE_FINAL

  @@map("training_quiz_placement")
}

enum TrainingQuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("training_quiz_status")
}

enum TrainingQuizVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@map("training_quiz_version_status")
}

enum TrainingQuizQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE

  @@map("training_quiz_question_type")
}

enum TrainingQuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  PASSED
  FAILED
  EXPIRED

  @@map("training_quiz_attempt_status")
}

enum TrainingCertificateStatus {
  ACTIVE
  REVOKED

  @@map("training_certificate_status")
}

model Company {
  id               String        @id @default(uuid()) @db.Uuid
  name             String        @db.VarChar(200)
  nameTranslations Json          @default("{}") @map("name_translations") @db.JsonB
  status           CompanyStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                     User[]
  settings                  Setting[]
  serviceAssignments        CompanyService[]
  serviceLifecycleEvents    CompanyServiceLifecycleEvent[]
  notifications             Notification[]
  notificationRecipients    NotificationRecipient[]
  invitationDispatches      UserInvitationDispatch[]
  fileAssets                FileAsset[]
  trainingCompanyAccess     TrainingCourseCompanyAccess[]
  trainingUserAccess        TrainingCourseUserAccess[]
  trainingLessonProgress    TrainingLessonProgress[]
  trainingCourseProgress    TrainingCourseProgress[]
  trainingQuizAttempts      TrainingQuizAttempt[]
  trainingCourseCompletions TrainingCourseCompletion[]
  trainingCertificates      TrainingCertificate[]

  @@map("companies")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  companyId       String?      @map("company_id") @db.Uuid
  accountScope    AccountScope @map("account_scope")
  email           String       @db.VarChar(320)
  whatsappNumber  String?      @map("whatsapp_number") @db.VarChar(16)
  certificateName String?      @map("certificate_name") @db.VarChar(250)
  normalizedEmail String       @unique @map("normalized_email") @db.VarChar(320)
  passwordHash    String?      @map("password_hash") @db.VarChar(255)
  status          UserStatus   @default(INVITED)
  emailVerifiedAt DateTime?    @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  company                   Company?                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userRoles                 UserRole[]
  sessions                  Session[]
  authTokens                AuthToken[]
  notificationRecipients    NotificationRecipient[]
  invitationDispatches      UserInvitationDispatch[]
  notificationProviderTests NotificationProviderTest[]
  serviceLifecycleEvents    CompanyServiceLifecycleEvent[]
  uiPreference              UserUiPreference?
  uploadedFileAssets        FileAsset[]                    @relation("FileAssetUploader")
  trainingUserAccess        TrainingCourseUserAccess[]
  trainingLessonProgress    TrainingLessonProgress[]
  trainingCourseProgress    TrainingCourseProgress[]
  trainingQuizAttempts      TrainingQuizAttempt[]
  trainingCourseCompletions TrainingCourseCompletion[]
  trainingCertificates      TrainingCertificate[]

  @@index([companyId])
  @@index([status])
  @@map("users")
}

model UserUiPreference {
  userId               String   @id @map("user_id") @db.Uuid
  sidebarCollapsed     Boolean  @default(false) @map("sidebar_collapsed")
  dashboardPreferences Json     @default("{}") @map("dashboard_preferences") @db.JsonB
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_ui_preferences")
}

model FileAsset {
  id               String              @id @default(uuid()) @db.Uuid
  accountScope     AccountScope        @map("account_scope")
  companyId        String?             @map("company_id") @db.Uuid
  kind             FileAssetKind
  storageProvider  FileStorageProvider @map("storage_provider")
  storageKey       String              @map("storage_key") @db.VarChar(512)
  originalFilename String              @map("original_filename") @db.VarChar(255)
  mimeType         String              @map("mime_type") @db.VarChar(127)
  sizeBytes        Int                 @map("size_bytes")
  sha256           String              @db.VarChar(64)
  status           FileAssetStatus     @default(READY)
  uploadedByUserId String              @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(6)

  company              Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  uploadedBy           User             @relation("FileAssetUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  trainingCourseCovers TrainingCourse[] @relation("TrainingCourseCoverImage")

  @@unique([storageProvider, storageKey])
  @@index([companyId])
  @@index([accountScope, status])
  @@index([companyId, status])
  @@index([kind])
  @@index([uploadedByUserId])
  @@index([createdAt])
  @@map("file_assets")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique @db.VarChar(100)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  scope       RoleScope
  isSystem    Boolean   @default(false) @map("is_system")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([scope])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(150)
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(128)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  action      String   @db.VarChar(150)
  targetType  String?  @map("target_type") @db.VarChar(100)
  targetId    String?  @map("target_id") @db.VarChar(255)
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorUserId])
  @@index([companyId])
  @@index([action])
  @@index([createdAt])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

model Setting {
  id             String       @id @default(uuid()) @db.Uuid
  key            String       @db.VarChar(150)
  category       String       @db.VarChar(80)
  valueType      String       @map("value_type") @db.VarChar(32)
  scope          SettingScope
  scopeKey       String       @map("scope_key") @db.VarChar(80)
  companyId      String?      @map("company_id") @db.Uuid
  value          Json?        @db.JsonB
  encryptedValue String?      @map("encrypted_value") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([scopeKey, key], map: "settings_scope_key_key_unique")
  @@index([scope, companyId], map: "settings_scope_company_id_idx")
  @@index([category], map: "settings_category_idx")
  @@map("settings")
}

model Service {
  id                      String               @id @default(uuid()) @db.Uuid
  key                     String               @unique @db.VarChar(100)
  name                    String               @db.VarChar(200)
  nameTranslations        Json                 @default("{}") @map("name_translations") @db.JsonB
  category                ServiceCategory
  description             String?              @db.VarChar(1000)
  descriptionTranslations Json                 @default("{}") @map("description_translations") @db.JsonB
  status                  ServiceCatalogStatus @default(ACTIVE)
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments          CompanyService[]
  features             ServiceFeature[]
  trainingCourseAccess TrainingCourseServiceAccess[]

  @@index([category, status], map: "services_category_status_idx")
  @@map("services")
}

model CompanyService {
  id                      String               @id @default(uuid()) @db.Uuid
  companyId               String               @map("company_id") @db.Uuid
  serviceId               String               @map("service_id") @db.Uuid
  displayName             String?              @map("display_name") @db.VarChar(200)
  displayNameTranslations Json                 @default("{}") @map("display_name_translations") @db.JsonB
  status                  CompanyServiceStatus @default(PROVISIONING)
  serviceUrl              String?              @map("service_url") @db.VarChar(2048)
  startsAt                DateTime?            @map("starts_at") @db.Timestamptz(6)
  expiresAt               DateTime?            @map("expires_at") @db.Timestamptz(6)
  notes                   String?              @db.VarChar(2000)
  internalNotes           String?              @map("internal_notes") @db.VarChar(2000)
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  company         Company                        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  service         Service                        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  features        CompanyServiceFeature[]
  lifecycleEvents CompanyServiceLifecycleEvent[]

  @@index([companyId, status], map: "company_services_company_status_idx")
  @@index([serviceId], map: "company_services_service_id_idx")
  @@index([expiresAt], map: "company_services_expires_at_idx")
  @@map("company_services")
}

model ServiceFeatureDefinition {
  id                         String                  @id @default(uuid()) @db.Uuid
  key                        String                  @unique @db.VarChar(100)
  name                       String                  @db.VarChar(200)
  nameTranslations           Json                    @default("{}") @map("name_translations") @db.JsonB
  description                String?                 @db.VarChar(1000)
  descriptionTranslations    Json                    @default("{}") @map("description_translations") @db.JsonB
  category                   ServiceCategory
  valueType                  ServiceFeatureValueType @map("value_type")
  parameterLabel             String                  @map("parameter_label") @db.VarChar(100)
  parameterLabelTranslations Json                    @default("{}") @map("parameter_label_translations") @db.JsonB
  defaultValue               Json                    @map("default_value") @db.JsonB
  valueTranslations          Json                    @default("{}") @map("value_translations") @db.JsonB
  unit                       String?                 @db.VarChar(32)
  status                     ServiceFeatureStatus    @default(ACTIVE)
  sortOrder                  Int                     @default(0) @map("sort_order")
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  serviceFeatures ServiceFeature[]

  @@index([category, status, sortOrder, id], map: "service_feature_definitions_category_status_sort_idx")
  @@map("service_feature_definitions")
}

model ServiceFeature {
  id                         String                  @id @default(uuid()) @db.Uuid
  serviceId                  String                  @map("service_id") @db.Uuid
  definitionId               String?                 @map("definition_id") @db.Uuid
  key                        String                  @db.VarChar(100)
  name                       String                  @db.VarChar(200)
  nameTranslations           Json                    @default("{}") @map("name_translations") @db.JsonB
  description                String?                 @db.VarChar(1000)
  descriptionTranslations    Json                    @default("{}") @map("description_translations") @db.JsonB
  valueType                  ServiceFeatureValueType @map("value_type")
  parameterLabel             String?                 @map("parameter_label") @db.VarChar(100)
  parameterLabelTranslations Json                    @default("{}") @map("parameter_label_translations") @db.JsonB
  defaultValue               Json                    @map("default_value") @db.JsonB
  valueTranslations          Json                    @default("{}") @map("value_translations") @db.JsonB
  unit                       String?                 @db.VarChar(32)
  status                     ServiceFeatureStatus    @default(ACTIVE)
  customerVisible            Boolean                 @default(true) @map("customer_visible")
  sortOrder                  Int                     @default(0) @map("sort_order")
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  service            Service                   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  definition         ServiceFeatureDefinition? @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  assignmentFeatures CompanyServiceFeature[]

  @@unique([serviceId, key], map: "service_features_service_id_key_unique")
  @@unique([serviceId, definitionId], map: "service_features_service_definition_unique")
  @@index([serviceId, status, sortOrder, id], map: "service_features_service_status_sort_idx")
  @@index([definitionId], map: "service_features_definition_id_idx")
  @@map("service_features")
}

model CompanyServiceFeature {
  id                      String                      @id @default(uuid()) @db.Uuid
  companyServiceId        String                      @map("company_service_id") @db.Uuid
  serviceFeatureId        String                      @map("service_feature_id") @db.Uuid
  value                   Json                        @db.JsonB
  valueTranslations       Json                        @default("{}") @map("value_translations") @db.JsonB
  source                  CompanyServiceFeatureSource @default(CATALOG_DEFAULT)
  customerVisibleOverride Boolean?                    @map("customer_visible_override")
  sortOrderOverride       Int?                        @map("sort_order_override")
  createdAt               DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  companyService CompanyService @relation(fields: [companyServiceId], references: [id], onDelete: Cascade)
  serviceFeature ServiceFeature @relation(fields: [serviceFeatureId], references: [id], onDelete: Restrict)

  @@unique([companyServiceId, serviceFeatureId], map: "company_service_features_assignment_feature_unique")
  @@index([companyServiceId, sortOrderOverride, id], map: "company_service_features_assignment_sort_idx")
  @@index([serviceFeatureId], map: "company_service_features_feature_id_idx")
  @@map("company_service_features")
}

model CompanyServiceLifecycleEvent {
  id                 String                        @id @default(uuid()) @db.Uuid
  companyServiceId   String                        @map("company_service_id") @db.Uuid
  companyId          String                        @map("company_id") @db.Uuid
  fromStatus         CompanyServiceStatus?         @map("from_status")
  toStatus           CompanyServiceStatus          @map("to_status")
  source             CompanyServiceLifecycleSource @default(ADMIN)
  reasonCode         String?                       @map("reason_code") @db.VarChar(80)
  reason             String?                       @db.VarChar(1000)
  actorUserId        String?                       @map("actor_user_id") @db.Uuid
  actorEmailSnapshot String?                       @map("actor_email_snapshot") @db.VarChar(320)
  effectiveAt        DateTime                      @map("effective_at") @db.Timestamptz(6)
  metadata           Json?                         @db.JsonB
  createdAt          DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)

  companyService CompanyService @relation(fields: [companyServiceId], references: [id], onDelete: Restrict)
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor          User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyServiceId, effectiveAt(sort: Desc), id(sort: Desc)], map: "company_service_lifecycle_assignment_effective_idx")
  @@index([companyId, effectiveAt(sort: Desc), id(sort: Desc)], map: "company_service_lifecycle_company_effective_idx")
  @@index([toStatus, effectiveAt], map: "company_service_lifecycle_status_effective_idx")
  @@map("company_service_lifecycle_events")
}

model Notification {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  templateKey    String   @map("template_key") @db.VarChar(150)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(200)
  actionUrl      String?  @map("action_url") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  recipients NotificationRecipient[]

  @@unique([companyId, idempotencyKey], map: "notifications_company_idempotency_unique")
  @@index([companyId, createdAt], map: "notifications_company_created_at_idx")
  @@map("notifications")
}

model NotificationRecipient {
  id             String    @id @default(uuid()) @db.Uuid
  notificationId String    @map("notification_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  locale         String    @db.VarChar(10)
  title          String    @db.VarChar(300)
  body           String    @db.VarChar(4000)
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  notification Notification           @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  company      Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveries   NotificationDelivery[]

  @@unique([notificationId, userId], map: "notification_recipients_notification_user_unique")
  @@index([companyId, userId, readAt, createdAt], map: "notification_recipients_inbox_idx")
  @@map("notification_recipients")
}

model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  recipientId       String                     @map("recipient_id") @db.Uuid
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  destination       String?                    @db.VarChar(320)
  attemptCount      Int                        @default(0) @map("attempt_count")
  maxAttempts       Int                        @default(3) @map("max_attempts")
  providerMessageId String?                    @map("provider_message_id") @db.VarChar(255)
  failureCode       String?                    @map("failure_code") @db.VarChar(80)
  failureMessage    String?                    @map("failure_message") @db.VarChar(255)
  lastAttemptAt     DateTime?                  @map("last_attempt_at") @db.Timestamptz(6)
  nextAttemptAt     DateTime?                  @map("next_attempt_at") @db.Timestamptz(6)
  sentAt            DateTime?                  @map("sent_at") @db.Timestamptz(6)
