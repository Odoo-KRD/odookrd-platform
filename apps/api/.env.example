NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://odookrd_app:CHANGE_ME@127.0.0.1:5432/odookrd_dev?schema=public"

AUTH_SESSION_IDLE_TTL_SECONDS=1800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=86400
AUTH_REMEMBER_SESSION_IDLE_TTL_SECONDS=604800
AUTH_REMEMBER_SESSION_ABSOLUTE_TTL_SECONDS=2592000

AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=128

AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
SETTINGS_ENCRYPTION_KEY=replace-with-a-32-byte-base64-encoded-key

PLATFORM_TIMEZONE=Asia/Baghdad
ODOOKRD_PORTAL_PUBLIC_URL=https://my.odoo.krd

FILES_STORAGE_PROVIDER=LOCAL
FILES_LOCAL_ROOT=/opt/odookrd-platform/var/uploads
TRAINING_LOCAL_MEDIA_ROOT=/opt/odookrd-platform/var/training-media

# Error monitoring. Leave blank to disable; the application behaves identically
# either way. Create separate Sentry projects for the API and the portal.
SENTRY_DSN=
# Set to the deployed commit so an issue points at the release that caused it:
#   SENTRY_RELEASE=$(git rev-parse --short HEAD)
SENTRY_RELEASE=
